  "commands": [
    {
      "note": "Install Flatpak",
      "command": "sudo apt install flatpak"
    },
    {
      "note": "Let the Software app install Flatpaks",
      "command": "sudo apt install gnome-software-plugin-flatpak"
    },
    {
      "note": "Add Flathub",
      "command": "sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo"
    },
    {
      "note": "Then restart your computer once.",
      "command": ""
